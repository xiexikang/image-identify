# 后端环境变量
APP_ENV=development
PORT=8082

# 数据库配置
DB_DSN=root:password@tcp(127.0.0.1:3306)/image_recognition?charset=utf8mb4&parseTime=True&loc=Local

# Redis配置
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# JWT密钥
JWT_SECRET=your-secret-key-change-this-in-production

# 百度智能云配置
BAIDU_API_KEY=your-baidu-api-key
BAIDU_SECRET_KEY=your-baidu-secret-key

# 文件上传配置
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR=./uploads